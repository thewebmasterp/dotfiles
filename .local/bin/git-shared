#!/usr/bin/env bash
# git-shared — git for the public dotfiles repo (work tree = $HOME).
# Ignore rules come straight from the whitelist source via core.excludesFile;
# no ~/.gitignore is ever created. Works from any directory.

DIR="$HOME/.local/share/gitReposDirs"

exec /usr/bin/git --git-dir="$DIR/.gitshared" --work-tree="$HOME" \
	-c core.excludesFile="$DIR/gitignore-shared" "$@"
