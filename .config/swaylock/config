daemonize
show-failed-attempts
clock
screenshot
effect-blur=13x13
effect-vignette=0.5:0.5
font="Inter"
indicator
indicator-radius=200
indicator-thickness=20
text-caps-lock-color=""
grace=2
grace-no-mouse
grace-no-touch
datestr=%a, %B %e
timestr=%I:%M %p
fade-in=0.4
ignore-empty-password

# Colors are intentionally NOT set here. They are passed as CLI flags by
# ~/.local/lib/sway/sway-lock-utils.sh, which sources the untracked file
# ~/.local/state/theme/swaylock-colors.sh (managed by darkman). This file
# never needs to change when switching between light/dark themes.