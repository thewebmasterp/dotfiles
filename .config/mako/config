# Take a look at the mako manpage with the command:
#   man 5 mako
# To view all configuration options.

font=MonaspiceAr Nerd Font 15
format=%s\n%b
sort=-time
layer=overlay
anchor=top-right

# Managed by darkman (dark-mode.d/light-mode.d/mako.sh) - never edit this
# line directly; it points at an untracked state file that darkman
# rewrites to include colors-mocha or colors-frappe.
include=~/.local/state/theme/mako

width=400
margin=3
padding=0,5,10
border-size=3
border-radius=10
icons=0
max-icon-size=64
default-timeout=5000
ignore-timeout=1

[urgency=high]
default-timeout=0